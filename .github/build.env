# Per-repo build settings, read by the shared workflows in
# d0g4sale/macos-release-workflows (called from .github/workflows).
# Plain KEY=value lines; no quotes (values may contain spaces).

# Human-facing name: DMG volume name and GitHub Release title.
APP_DISPLAY_NAME=Container Manager
PROJECT=Container Manager.xcodeproj
SCHEME=Container Manager
# Unit-test bundle run by CI and as the release gate.
UNIT_TEST_TARGET=Container ManagerTests
# URL-friendly slug for release assets: <slug>-<version>.dmg / .zip
ARTIFACT_NAME=Container-Manager
# Apple Developer team for Developer ID signing.
TEAM_ID=MKTMGKS2F9
# true if the .xcodeproj is generated from project.yml by XcodeGen.
XCODEGEN=true
